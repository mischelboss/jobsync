# Copy this file to `.env` and adjust. `.env` is git-ignored — never commit it.
#
# Docker users: everything here is optional. `docker compose up` works without
# an .env file. Native `npm run dev` needs at least DATABASE_URL.

# SQLite database for native development (`npm run dev`). Docker sets its own.
DATABASE_URL=file:./dev.db

# Set this on remote servers/homelabs, otherwise activity times may shift.
# Example: Europe/Berlin
TZ=America/Edmonton

# For a homelab server, use your server's address, e.g. http://192.168.x.x:3737
NEXTAUTH_URL=http://localhost:3737

# Required when the app is not served from localhost (homelab IP, reverse proxy)
AUTH_TRUST_HOST=true

# AUTH_SECRET signs sessions. If unset, the Docker entrypoint generates a random
# one on first start and stores it in the data volume (/data/.AUTH_SECRET).
# For native dev, or to set it yourself: openssl rand -base64 32
# AUTH_SECRET=

# ENCRYPTION_KEY encrypts the API keys and the IMAP password stored in the
# database. If unset, the Docker entrypoint generates one on first start and
# stores it in the data volume (/data/.ENCRYPTION_KEY).
# Native dev needs it set. It must stay stable: changing it makes all stored
# API keys and the IMAP password unrecoverable (you would have to re-enter them).
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

# Optional: API keys can also be entered in the app under Settings > API Keys.
# A key saved in the app takes precedence over these environment variables.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=       # https://platform.deepseek.com
# GEMINI_API_KEY=         # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=     # https://openrouter.ai/keys
# RAPIDAPI_KEY=           # JSearch job source
# TAVILY_API_KEY=         # web research for interview preparation

# Ollama (local models). For a homelab server, use its address, e.g.
# http://192.168.x.x:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Enables the MCP server in production (default: on in dev, off in prod)
MCP_ENABLED=true
